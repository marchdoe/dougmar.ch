## PREVIOUS MOCKUP — the page the critic reviewed; revise this file, do not start over

```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Doug March — Select a busy man</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;700;900&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --gold-200:#FADF7E; --gold-300:#F7CB3F; --gold-400:#F4B90A; --gold-500:#DA9E00;
    --sand-50:#FAF7EF; --sand-100:#F1EBDA; --sand-300:#C9BB97; --sand-400:#A38F63;
    --sand-500:#7A6A41; --sand-600:#574B2C; --sand-700:#3A311C; --sand-800:#221D10; --sand-900:#16130B;
    --pad:clamp(24px,5vw,72px);
  }
  *{box-sizing:border-box;}
  html{-webkit-text-size-adjust:100%;}
  body{
    margin:0; background:var(--sand-900); color:var(--sand-50);
    font-family:"Figtree",system-ui,sans-serif; font-size:16px; line-height:1.5;
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
    font-feature-settings:"kern","liga";
  }
  a{color:inherit;text-decoration:none;transition:color 140ms ease;}
  h1,h2,h3,h4{margin:0;font-weight:700;line-height:1.05;}
  p{margin:0;}

  /* ---------- SPLIT SHELL ---------- */
  .split{
    display:grid;
    grid-template-columns:1.35fr 1fr;
    min-height:100vh;
    align-items:stretch;
  }

  /* ---------- GOLD FIELD (left) ---------- */
  .field{
    background:var(--gold-400);
    color:var(--sand-900);
    padding:var(--pad);
    display:flex; flex-direction:column; justify-content:space-between;
    position:sticky; top:0; height:100vh;
    border-right:2px solid var(--sand-900);
    min-height:560px;
  }
  .brand{display:flex;align-items:center;gap:14px;color:var(--sand-900);}
  .brand svg{width:44px;height:auto;display:block;}
  .brand .wm{
    font-family:"Unbounded",sans-serif;font-weight:700;font-size:20px;
    letter-spacing:-0.01em;color:var(--sand-900);white-space:nowrap;
  }
  .brand .role{
    font-family:"Figtree";font-weight:500;font-size:12px;letter-spacing:.08em;
    text-transform:uppercase;color:#5C4000;margin-top:2px;
  }
  .brandwrap{display:flex;flex-direction:column;}

  .hero{margin:clamp(24px,4vh,48px) 0;}
  .hero h1{
    font-family:"Unbounded",sans-serif; font-weight:900;
    font-size:clamp(64px,8.5vw,136px); line-height:0.92; letter-spacing:-0.01em;
    color:var(--sand-900); text-transform:uppercase; text-wrap:balance;
  }
  .hero h1 span{display:block;}
  .hero .imperative{
    font-family:"Figtree";font-weight:700;font-size:13px;letter-spacing:.14em;
    text-transform:uppercase;color:#5C4000;margin-bottom:18px;
  }
  .field-foot{
    display:flex;flex-wrap:wrap;gap:20px 40px;align-items:baseline;
    font-family:"Figtree";
  }
  .field-foot .k{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#5C4000;font-weight:600;}
  .field-foot .v{font-size:15px;color:var(--sand-900);font-weight:500;}
  .field-foot .sun{
    display:inline-block;width:12px;height:12px;border-radius:50%;
    background:var(--sand-900);margin-right:6px;vertical-align:baseline;
  }

  /* ---------- DARK LEDGER (right) ---------- */
  .ledger{
    background:var(--sand-900); padding:var(--pad);
    display:flex; flex-direction:column;
  }
  .nav{
    display:flex; flex-direction:column; align-items:flex-end; gap:8px;
    margin-bottom:clamp(40px,7vh,72px);
  }
  .nav a{
    font-family:"Figtree";font-weight:500;font-size:16px;color:var(--sand-300);
    padding:6px 2px;position:relative;
  }
  .nav a::after{
    content:"";position:absolute;left:auto;right:0;bottom:2px;width:0;height:1px;
    background:var(--gold-400);transition:width 160ms ease;
  }
  .nav a:hover{color:var(--gold-400);}
  .nav a:hover::after{width:100%;}

  .clause{margin-bottom:clamp(28px,5vh,48px);}
  .clause h2{
    font-family:"Unbounded",sans-serif;font-weight:700;
    font-size:clamp(24px,3vw,40px);line-height:1.05;letter-spacing:-0.01em;
    color:var(--gold-400);text-transform:lowercase;
  }
  .clause .quote{
    margin-top:20px;max-width:60ch;color:var(--sand-300);font-size:16px;line-height:1.6;
    border-left:2px solid var(--sand-700);padding-left:18px;
  }
  .clause .attr{
    margin-top:10px;font-family:"Figtree";font-weight:600;font-size:13px;
    letter-spacing:.08em;text-transform:uppercase;color:var(--sand-400);
    padding-left:18px;
  }

  .sec-label{
    font-family:"Figtree";font-weight:700;font-size:12px;letter-spacing:.14em;
    text-transform:uppercase;color:var(--sand-500);
    padding-bottom:12px;border-bottom:1px solid var(--sand-700);
    margin:clamp(28px,5vh,48px) 0 0;
    display:flex;justify-content:space-between;align-items:baseline;
  }
  .sec-label .cnt{color:var(--sand-400);font-weight:500;letter-spacing:.08em;}

  /* ledger rows */
  .row{
    display:grid;grid-template-columns:1fr auto;gap:8px 16px;align-items:baseline;
    padding:14px 0;border-bottom:1px solid var(--sand-700);
    transition:border-color 160ms ease;
  }
  .row:hover{border-color:var(--sand-600);}
  .row .lbl{font-family:"Figtree";font-weight:500;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--sand-400);grid-column:1;}
  .row .main{grid-column:1;font-size:17px;color:var(--sand-50);font-weight:500;}
  .row .val{
    grid-column:2;grid-row:1 / span 2;align-self:center;text-align:right;
    font-variant-numeric:tabular-nums;font-weight:700;font-size:18px;color:var(--gold-400);
    white-space:nowrap;
  }
  .row .val.muted{color:var(--sand-300);font-weight:500;}
  .row .sub{grid-column:1;font-size:13px;color:var(--sand-400);}

  /* leaderboard */
  .board{padding:14px 0;border-bottom:1px solid var(--sand-700);}
  .board .lbl{font-family:"Figtree";font-weight:500;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--sand-400);margin-bottom:10px;}
  .board .lb{
    display:flex;justify-content:space-between;align-items:baseline;
    padding:4px 0;font-variant-numeric:tabular-nums;
  }
  .board .lb .who{font-size:15px;color:var(--sand-50);}
  .board .lb .sc{font-weight:700;font-size:16px;color:var(--sand-300);}
  .board .lb.lead .who{color:var(--sand-50);font-weight:600;}
  .board .lb.lead .sc{color:var(--gold-400);}

  /* work rows */
  .work a.row{cursor:pointer;}
  .work .main{font-family:"Unbounded",sans-serif;font-weight:700;font-size:19px;letter-spacing:-0.01em;text-transform:uppercase;}
  .work a.row:hover .main{color:var(--gold-400);}
  .work .type{grid-column:2;grid-row:1 / span 2;align-self:center;text-align:right;font-family:"Figtree";font-weight:500;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--sand-400);}
  .work .type b{display:block;color:var(--sand-300);font-weight:700;font-variant-numeric:tabular-nums;}

  .featured{
    background:var(--sand-800);border:1px solid var(--sand-700);
    padding:clamp(20px,3vw,28px);margin-top:16px;
  }
  .featured .tag{font-family:"Figtree";font-weight:700;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-400);}
  .featured h3{
    font-family:"Unbounded",sans-serif;font-weight:700;font-size:clamp(26px,3.4vw,38px);
    letter-spacing:-0.01em;color:var(--sand-50);margin:10px 0 12px;text-transform:uppercase;
  }
  .featured p{color:var(--sand-300);font-size:16px;line-height:1.6;max-width:52ch;}
  .featured .ext{
    display:inline-flex;align-items:center;gap:8px;margin-top:18px;
    font-family:"Figtree";font-weight:700;font-size:14px;letter-spacing:.04em;
    color:var(--sand-900);background:var(--gold-400);padding:11px 18px;
  }
  .featured .ext:hover{background:var(--gold-300);color:var(--sand-900);}
  .featured .ext .arw{font-family:"Unbounded";}

  .lfoot{
    margin-top:auto;padding-top:clamp(32px,5vh,48px);
    border-top:1px solid var(--sand-700);
    display:flex;flex-wrap:wrap;gap:14px 32px;align-items:baseline;
    font-family:"Figtree";font-size:13px;color:var(--sand-400);
  }
  .lfoot .k{font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--sand-500);font-size:11px;margin-right:8px;}
  .lfoot .music b{color:var(--sand-300);font-weight:600;}
  .lfoot .hn{width:100%;color:var(--sand-500);font-style:italic;}

  /* ---------- RESPONSIVE ---------- */
  @media (max-width:860px){
    .split{grid-template-columns:1fr;}
    .field{
      position:static;height:auto;min-height:78vh;
      border-right:none;border-bottom:2px solid var(--sand-900);
    }
    .nav{flex-direction:row;flex-wrap:wrap;justify-content:flex-start;gap:16px 20px;}
    .nav a{padding:10px 0;min-height:44px;display:flex;align-items:center;}
    .nav a::after{left:0;right:auto;}
    .row .val,.work .type{font-size:16px;}
  }
  @media (max-width:480px){
    .brand .wm{font-size:17px;}
    .brand svg{width:38px;}
    .field-foot{gap:14px 24px;}
  }
  @media (prefers-reduced-motion:reduce){
    *{transition:none!important;}
  }
</style>
</head>
