import { css, cx } from '../../styled-system/css'

/**
 * The material library. Generated by the orchestrator from
 * scripts/templates/Material.tsx.template on every run, exactly the way
 * app/components/BrandLockup.tsx is. Do not edit by hand and do not draw a
 * material anywhere else: scripts/utils/build-validator.js fails the build
 * over an `feTurbulence` in any file the engineer owns, the way it fails a
 * pasted brand mark.
 *
 * Why it exists: every nightly build was a flat field, type and a hairline,
 * because nothing in the pipeline could put texture on a page. External
 * images are banned and nothing generates a picture, so the texture is
 * synthesized here, from the semantic tokens and the day's seed, and the Art
 * Director declares which one in ===SHELL=== as `ground_material`. See #505.
 * Mesh, halftone, ruled and dot grounds were cut in Spec 14 (#794): the owner
 * rejected them, and `none` is the default.
 *
 * PLACEMENT. `<Ground>` is absolute, inset 0, pointer-events none, z-index 0.
 * It is meant to be the first child of a relatively positioned hero, with the
 * hero's content in a sibling set position: relative and z-index: 1 so it
 * paints above the material. The material sits ON a token ground and never
 * replaces it: the colour floor is measured off backgrounds, and a texture
 * layer paints none of its own.
 *
 * DETERMINISM. Everything follows from `seed`: no Math.random, no Date. The
 * one value it drives, grain's baseFrequency, is an SVG filter attribute,
 * which Panda cannot express and which is set directly.
 */

type GroundMaterial = 'none' | 'grain'

type GroundProps = {
  material: GroundMaterial
  /** The day's seed, from scripts/utils/material.js materialSeed(date). */
  seed: number
  className?: string
}

const root = css({
  position: 'absolute',
  inset: '0px',
  zIndex: 0,
  pointerEvents: 'none',
  overflow: 'hidden',
})

/**
 * grain: fractal noise, mapped to alpha, flooded with the `text` ink and
 * laid over the field at low opacity. The svg is set in `text` so the
 * flood's currentColor follows the day's ink on any ground.
 */
const grainSvg = css({
  position: 'absolute',
  inset: '0px',
  width: '100%',
  height: '100%',
  display: 'block',
  color: 'text',
  opacity: 0.2,
})

function Grain({ seed }: { seed: number }) {
  // 0.6000 to 0.9000, four places, from the seed.
  const baseFrequency = (0.6 + (seed % 3001) / 10000).toFixed(4)
  const id = `ground-grain-${seed}`
  return (
    <svg
      className={grainSvg}
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      preserveAspectRatio="none"
    >
      <filter id={id} x="0" y="0" width="100%" height="100%" colorInterpolationFilters="sRGB">
        <feTurbulence
          type="fractalNoise"
          baseFrequency={baseFrequency}
          numOctaves="3"
          seed={seed % 1000}
          stitchTiles="stitch"
        />
        <feColorMatrix type="luminanceToAlpha" result="alpha" />
        <feFlood floodColor="currentColor" result="ink" />
        <feComposite in="ink" in2="alpha" operator="in" />
      </filter>
      <rect width="100%" height="100%" filter={`url(#${id})`} />
    </svg>
  )
}

/**
 * The declared material, over the hero's own field.
 *
 * `data-ground-material` is how the surface gate and the DOM tests find the
 * layer; the seed rides beside it so an archived page says which draw it was.
 */
export function Ground({ material, seed, className }: GroundProps) {
  if (material === 'none') return null
  return (
    <div
      className={cx(root, className)}
      data-ground-material={material}
      data-ground-seed={seed}
      aria-hidden="true"
    >
      <Grain seed={seed} />
    </div>
  )
}
