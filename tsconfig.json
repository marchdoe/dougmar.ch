{
  "include": ["**/*.ts", "**/*.tsx"],
  // archive/ holds frozen daily-build snapshots (each with its own preset.ts
  // written against that day's token schema) — historical artifacts, not code.
  "exclude": ["node_modules", "dist", "archive"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    // TS files that import scripts/, elements/ or shared/ JS read its types
    // from JSDoc. `include` still names only .ts/.tsx, so a JS file enters the
    // program only when something imports it, and checkJs stays off.
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
