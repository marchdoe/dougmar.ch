{
  "name": "dougmarch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare": "panda codegen",
    "dev": "panda codegen && vite",
    "build": "panda codegen && node scripts/generate-archive-json.js && vite build && node scripts/pin-inline-scripts.js",
    "preview": "vite preview",
    "test": "panda codegen && vitest run",
    "test:coverage": "panda codegen && vitest run --coverage",
    "test:e2e:site": "playwright test --project=site-health",
    "test:e2e:dev": "playwright test --project=dev-panel",
    "test:e2e": "playwright test",
    "lint": "biome ci .",
    "typecheck": "panda codegen && tsc --noEmit",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "codegen": "panda codegen",
    "codegen:watch": "panda codegen --watch",
    "pipeline": "node scripts/run-pipeline.js",
    "pipeline:collect": "node scripts/collect-signals.js",
    "pipeline:canary": "node scripts/canary.js",
    "pipeline:replay": "node scripts/replay-mockup.js",
    "taste": "node scripts/taste-note.js",
    "unslop:sync": "node scripts/sync-unslop.js",
    "mockup:fidelity": "node scripts/mockup-fidelity-cli.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@vercel/functions": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@biomejs/biome": "^2.5.15",
    "@pandacss/dev": "^1.12.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.5",
    "fallow": "^3.31.0",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
