{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!archive",
      "!styled-system",
      "!public",
      "!dist",
      "!elements/preset.ts",
      "!elements/chassis-preset.ts",
      "!app/routeTree.gen.ts",
      "!docs",
      "!references",
      "!signals",
      "!test-results"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noCommentText": "warn",
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn"
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "a11y": {
        "preset": "recommended",
        "useButtonType": "warn",
        "noSvgWithoutTitle": "warn",
        "useSemanticElements": "warn",
        "useKeyWithClickEvents": "warn",
        "useFocusableInteractive": "warn",
        "noStaticElementInteractions": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "overrides": [
    {
      // fallow writes and reads its own config as JSONC. Biome's JSON parser
      // rejects the comments unless told to expect them.
      "includes": [".fallowrc.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    },
    {
      // Chassis type scales are typographic ratios written the way a designer
      // reads them: 1.414 is the augmented fourth, not an approximation of
      // Math.SQRT2. Swapping in the standard-library constant would move every
      // computed step size.
      "includes": ["**/chassis/*.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noApproximativeNumericConstant": "off"
          }
        }
      }
    },
    {
      "includes": ["app/dev/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noCommentText": "off"
          }
        }
      }
    }
  ]
}
